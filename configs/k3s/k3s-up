#!/usr/bin/env bash
# Start the local k3s cluster (also on every boot) and point kubectl at it as context "k3s".
set -euo pipefail

sudo systemctl enable --now k3s

echo "waiting for k3s to be ready..."
for _ in $(seq 90); do
  sudo k3s kubectl get --raw /readyz >/dev/null 2>&1 && break
  sleep 2
done
sudo k3s kubectl get --raw /readyz >/dev/null 2>&1 \
  || { echo "k3s did not become ready; see: journalctl -u k3s" >&2; exit 1; }

# k3s names everything "default"; rename to "k3s" so it merges cleanly with other clusters
mkdir -p ~/.kube
tmp=$(mktemp)
trap 'rm -f "$tmp" "$tmp.merged"' EXIT
sed 's/: default$/: k3s/' /etc/rancher/k3s/k3s.yaml > "$tmp"
if [[ -s ~/.kube/config ]]; then
  # k3s first: its fresh credentials win, and it becomes the current context
  KUBECONFIG="$tmp:$HOME/.kube/config" kubectl config view --flatten > "$tmp.merged"
  mv "$tmp.merged" ~/.kube/config
else
  cp "$tmp" ~/.kube/config
fi
chmod 600 ~/.kube/config
kubectl config use-context k3s >/dev/null

kubectl get nodes
echo "k3s is up (context: k3s). Stop it with k3s-down."
